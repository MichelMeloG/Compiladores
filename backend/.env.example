# Desenvolvimento local: sem credencial GCP. Copie para .env e carregue com
#   node --env-file=.env --import tsx src/main.ts      (ou exporte as variáveis)
STORE=memory
AUTH_MODE=off
PORT=8080
LOG_LEVEL=info

# Segredo por dispositivo (mínimo 16 caracteres): Bearer em /device/sensors,
# HMAC em hello/poll/events (firmware autônomo). NUNCA commitar valores reais.
DEVICE_SECRETS_JSON={"RB-01":"troque-por-um-segredo-longo-e-aleatorio"}

# Operação real de bancada (sem missões/telemetria fictícias).
SEED_PROFILE=clean

# Origem da dashboard em desenvolvimento
CORS_ORIGINS=http://localhost:3000

# Produção (definidas pela infra, ver ../infra/ENV_CONTRACT.md):
#   NODE_ENV=production STORE=firestore GCP_PROJECT=... AUTH_MODE=firebase
#   ALLOWED_OPERATOR_EMAILS=... INTERNAL_AUDIENCE=... PUBSUB_PUSH_SA=... SCHEDULER_SA=...
