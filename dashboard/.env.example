# ---------------------------------------------------------------------------
# Rover Monitor — configuração do frontend
#
# Copie este arquivo para `.env` e ajuste os valores.
# Apenas variáveis com prefixo VITE_ chegam ao navegador.
# ---------------------------------------------------------------------------

# URL base do backend REST que serve os dados do carrinho.
# Todos os endpoints do contrato são relativos a esta URL.
# Ex.: com o valor abaixo, o dashboard chama http://localhost:8080/api/missions
#
# Deixe como "/api" caso o backend seja servido na mesma origem do frontend
# (via proxy reverso ou `server.proxy` no vite.config.ts).
VITE_API_URL="http://localhost:8080/api"
